        "import cv2\n",
        "import numpy as np\n",
        "from matplotlib import pyplot as plt\n",
        "\n",
        "# 1. إنشاء \"منتج\" صناعي به خدش (مثلما فعلنا سابقاً)\n",
        "product = np.ones((150, 150, 3), dtype=np.uint8) * 200\n",
        "cv2.line(product, (40, 40), (110, 110), (0, 0, 0), 3) # الخدش\n",
        "\n",
        "# 2. تحضير لوحة \"الحزام الناقل\" (شاشة سوداء عريضة)\n",
        "conveyor_belt = np.zeros((200, 600, 3), dtype=np.uint8)\n",
        "\n",
        "frames_to_show = []\n",
        "\n",
        "# 3. محاكاة حركة المنتج على الحزام (من اليسار إلى اليمين)\n",
        "print(\"⏳ جاري محاكاة حركة الحزام وفحص المنتج...\")\n",
        "for x_position in range(50, 450, 150): # نحرك المنتج 3 مرات فقط لسرعة العرض\n",
        "\n",
        "    # نسخ لوحة الحزام الفارغة\n",
        "    current_frame = conveyor_belt.copy()\n",
        "\n",
        "    # وضع المنتج في الموقع الجديد\n",
        "    current_frame[25:175, x_position:x_position+150] = product\n",
        "\n",
        "    # --- هنا يبدأ عمل الذكاء الاصطناعي (الفحص) ---\n",
        "    # نأخذ الصورة الرمادية للمنتج فقط لفحصه\n",
        "    gray_product = cv2.cvtColor(product, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # نكتشف العيب (الخدش)\n",
        "    edges = cv2.Canny(gray_product, 100, 200)\n",
        "    contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
        "\n",
        "    for contour in contours:\n",
        "        c_x, c_y, w, h = cv2.boundingRect(contour)\n",
        "        if w > 10 and h > 10: # إذا وجدنا الخدش\n",
        "            # نرسم المربع الأحمر حول العيب (في مكانه الجديد على الحزام)\n",
        "            cv2.rectangle(current_frame,\n",
        "                          (x_position + c_x, 25 + c_y),\n",
        "                          (x_position + c_x + w, 25 + c_y + h),\n",
        "                          (0, 0, 255), 2)\n",
        "            # نكتب كلمة DEFECT (عيب)\n",
        "            cv2.putText(current_frame, \"DEFECT\", (x_position, 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1)\n",
        "\n",
        "    frames_to_show.append(current_frame)\n",
        "\n",
