        "import sqlite3\n",
        "import pandas as pd\n",
        "\n",
        "# 1. إعداد قاعدة البيانات\n",
        "conn = sqlite3.connect(':memory:')\n",
        "cursor = conn.cursor()\n",
        "\n",
        "cursor.execute(\"CREATE TABLE countries (id INTEGER PRIMARY KEY, name TEXT, region TEXT)\")\n",
        "cursor.execute(\"CREATE TABLE production (id INTEGER PRIMARY KEY, country_id INTEGER, barrels INTEGER)\")\n",
        "\n",
        "# 2. إدخال البيانات\n",
        "cursor.execute(\"INSERT INTO countries VALUES (1, 'العراق', 'الشرق الأوسط')\")\n",
        "cursor.execute(\"INSERT INTO countries VALUES (2, 'السعودية', 'الشرق الأوسط')\")\n",
        "cursor.execute(\"INSERT INTO countries VALUES (3, 'أمريكا', 'أمريكا الشمالية')\")\n",
        "\n",
        "cursor.execute(\"INSERT INTO production VALUES (1, 1, 4000000)\") # العراق\n",
        "cursor.execute(\"INSERT INTO production VALUES (2, 1, 4500000)\") # العراق (مرة أخرى)\n",
        "cursor.execute(\"INSERT INTO production VALUES (3, 2, 9000000)\") # السعودية\n",
        "cursor.execute(\"INSERT INTO production VALUES (4, 3, 12000000)\") # أمريكا\n",
        "conn.commit()\n",
        "\n",
        "# 3. الاستعلام الشامل (Master Query)\n",
        "query = \"\"\"\n",
        "    SELECT countries.name AS \"الدولة\",\n",
        "           countries.region AS \"المنطقة\",\n",
        "           SUM(production.barrels) AS \"إجمالي الإنتاج\"\n",
        "    FROM countries\n",
        "    JOIN production ON countries.id = production.country_id\n",
        "    WHERE countries.region = 'الشرق الأوسط'\n",
        "    GROUP BY countries.name, countries.region\n",
        "    ORDER BY \"إجمالي الإنتاج\" DESC\n",
        "\"\"\"\n",
        "\n",
        "# 4. التنفيذ والعرض\n",
