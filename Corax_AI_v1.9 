        "import sqlite3\n",
        "import pandas as pd\n",
        "\n",
        "# 1. إنشاء قاعدة البيانات في الذاكرة\n",
        "conn = sqlite3.connect(':memory:')\n",
        "cursor = conn.cursor()\n",
        "\n",
        "# 2. إنشاء جدول الدول\n",
        "cursor.execute('''\n",
        "    CREATE TABLE countries (\n",
        "        id INTEGER PRIMARY KEY,\n",
        "        name TEXT,\n",
        "        region TEXT\n",
        "    )\n",
        "''')\n",
        "\n",
        "# 3. إنشاء جدول إنتاج النفط\n",
        "cursor.execute('''\n",
        "    CREATE TABLE oil_production (\n",
        "        production_id INTEGER PRIMARY KEY,\n",
        "        country_id INTEGER,\n",
        "        barrels_per_day INTEGER\n",
        "    )\n",
        "''')\n",
        "\n",
        "# 4. إدخال البيانات الوهمية\n",
        "cursor.execute(\"INSERT INTO countries VALUES (1, 'العراق', 'الشرق الأوسط')\")\n",
        "cursor.execute(\"INSERT INTO countries VALUES (2, 'السعودية', 'الشرق الأوسط')\")\n",
        "cursor.execute(\"INSERT INTO countries VALUES (3, 'الولايات المتحدة', 'أمريكا الشمالية')\")\n",
        "\n",
        "cursor.execute(\"INSERT INTO oil_production VALUES (101, 1, 4000000)\") # العراق\n",
        "cursor.execute(\"INSERT INTO oil_production VALUES (102, 2, 9000000)\") # السعودية\n",
        "cursor.execute(\"INSERT INTO oil_production VALUES (103, 1, 4500000)\") # العراق مرة أخرى\n",
        "\n",
        "conn.commit()\n",
        "\n",
        "# 5. عملية الربط (JOIN) - نطلب اسم الدولة مع كمية إنتاجها\n",
        "query = \"\"\"\n",
        "    SELECT countries.name, countries.region, oil_production.barrels_per_day\n",
        "    FROM countries\n",
        "    LEFT JOIN oil_production ON countries.id = oil_production.country_id\n",
        "\"\"\"\n",
        "\n",
        "# 6. تنفيذ الكود وعرض النتيجة\n",
        "df_joined = pd.read_sql_query(query, conn)\n",
        "print(\"--- تقرير إنتاج النفط حسب الدولة ---\")\n",
        "display(df_joined)"
