        "import os\n",
        "from google import genai\n",
        "from google.genai import types\n",
        "from google.colab import userdata\n",
        "\n",
        "os.environ[\"PYTHONIOENCODING\"] = \"utf-8\"\n",
        "api_key = userdata.get('GEMINI_API_KEY').strip().split()[0]\n",
        "client = genai.Client(api_key=api_key)\n",
        "\n",
        "# قائمة النماذج التي سنجربها بالترتيب\n",
        "models_to_try = [\"gemini-3.5-flash\", \"gemini-3.8-flash\", \"gemini-flash-latest\"]\n",
        "\n",
        "print(\"🤖 مرحباً! أنا مساعدك الذكي (نظام الحماية ضد الضغط). اكتب 'خروج' للإنهاء.\")\n",
        "\n",
        "# سجل المحادثة بالتنسيق الصحيح\n",
        "history = []\n",
        "\n",
        "while True:\n",
        "    user_input = input(\"\\nأنت: \")\n",
        "\n",
        "    if user_input == \"خروج\" or user_input == \"exit\":\n",
        "        print(\"🤖: إلى اللقاء! 👋\")\n",
        "        break\n",
        "\n",
        "    response_text = None\n",
        "    used_model = None\n",
        "\n",
        "    for model_name in models_to_try:\n",
        "        try:\n",
        "            # إنشاء المحادثة مع تمرير السجل الصحيح\n",
        "            chat = client.chats.create(model=model_name, history=history)\n",
        "            response = chat.send_message(user_input)\n",
        "            response_text = response.text\n",
        "            used_model = model_name\n",
        "            print(f\"🤖 [{model_name}]:\", response_text)\n",
        "            break\n",
        "\n",
        "        except Exception as e:\n",
        "            if \"503\" in str(e) or \"UNAVAILABLE\" in str(e):\n",
        "                print(f\"⏳ النموذج {model_name} مشغول، جاري التحويل لنموذج آخر...\")\n",
        "            else:\n",
        "                print(f\"❌ خطأ في {model_name}: {e}\")\n",
        "\n",
        "    if response_text:\n",
        "        # تحديث السجل بالتنسيق الصحيح (types.Content)\n",
        "        history.append(types.Content(role=\"user\", parts=[types.Part(text=user_input)]))\n",
        "        history.append(types.Content(role=\"model\", parts=[types.Part(text=response_text)]))\n",
        "    else:\n",
        "        print(\"⚠️ عذراً، جميع النماذج مشغولة جداً حالياً. جرب بعد قليل.\")"
