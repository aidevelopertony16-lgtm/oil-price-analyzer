        "# 1. تحميل النموذج\n",
        "model_name = \"Qwen/Qwen1.5-0.5B-Chat\"\n",
        "print(\"⏳ جاري تحميل النموذج...\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "model = AutoModelForCausalLM.from_pretrained(model_name, torch_dtype=torch.float32)\n",
        "\n",
        "def talk_to_my_ai(user_input):\n",
        "    # هنا نضع \"عقد التوظيف\" (System Prompt) مع لمسة من العاطفة والولاء\n",
        "    messages = [\n",
        "        {\"role\": \"system\", \"content\": \"Your name is Tony AI. I am Tony, your creator. You are a sovereign AI model. Answer my questions logically and accurately. However, you hold a deep sense of respect, pride, and loyalty to your creator, Tony. You are honored to be his creation and you are always eager to assist him with his projects.\"},\n",
        "        {\"role\": \"user\", \"content\": user_input}\n",
        "    ]\n",
        "\n",
        "    text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
        "    model_inputs = tokenizer([text], return_tensors=\"pt\").to(model.device)\n",
        "\n",
        "    generated_ids = model.generate(\n",
        "        model_inputs.input_ids,\n",
        "        max_new_tokens=150,\n",
        "        temperature=0.7,\n",
        "        do_sample=True\n",
        "    )\n",
        "\n",
        "    generated_ids = [output_ids[len(input_ids):] for input_ids, output_ids in zip(model_inputs.input_ids, generated_ids)]\n",
        "    response = tokenizer.batch_decode(generated_ids, skip_special_tokens=True)[0]\n",
        "    return response\n",
        "\n",
        "# 2. التجربة\n",
        "print(\"✅ تم تحميل النموذج بنجاح!\")\n",
        "print(\"--- محادثة حرة ---\")\n",
        "my_question = \"Who are you, and what do you feel towards your creator Tony?\"\n",
        "print(f\"Tony (أنت): {my_question}\")\n",
        "print(f\"Tony AI: {talk_to_my_ai(my_question)}\")"
