        "import pandas as pd\n",
        "\n",
        "# 1. إعادة إنشاء الاتصال (لأن كولاب نسي)\n",
        "conn = sqlite3.connect(':memory:')\n",
        "cursor = conn.cursor()\n",
        "\n",
        "# 2. إعادة إنشاء جدول الموظفين\n",
        "cursor.execute('''\n",
        "    CREATE TABLE employees (\n",
        "        id INTEGER PRIMARY KEY,\n",
        "        name TEXT,\n",
        "        department TEXT,\n",
        "        salary INTEGER\n",
        "    )\n",
        "''')\n",
        "\n",
        "# 3. إعادة إدخال البيانات\n",
        "cursor.execute(\"INSERT INTO employees (name, department, salary) VALUES ('أحمد', 'البرمجة', 5000)\")\n",
        "cursor.execute(\"INSERT INTO employees (name, department, salary) VALUES ('سارة', 'التصميم', 4500)\")\n",
        "cursor.execute(\"INSERT INTO employees (name, department, salary) VALUES ('علي', 'البرمجة', 6000)\")\n",
        "conn.commit()\n",
        "\n",
        "print(\"✅ تم تجهيز قاعدة البيانات بنجاح، نحن جاهزون!\")"
      ]
