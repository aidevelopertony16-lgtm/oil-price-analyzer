        "!pip install gradio yfinance scikit-learn pandas matplotlib -q\n",
        "\n",
        "import gradio as gr\n",
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "\n",
        "def predict_oil_direction(ticker_symbol):\n",
        "    if not ticker_symbol:\n",
        "        return \"الرجاء إدخال رمز\", None\n",
        "\n",
        "    try:\n",
        "        # 1. جلب البيانات (آخر سنة كافية للتدريب)\n",
        "        data = yf.download(ticker_symbol, period=\"1y\", progress=False)\n",
        "        if data.empty:\n",
        "            return \"لم يتم العثور على بيانات لهذا الرمز.\", None\n",
        "\n",
        "        # 2. تجهيز الميزات (Features)\n",
        "        data['MA5'] = data['Close'].rolling(window=5).mean()\n",
        "        data['MA10'] = data['Close'].rolling(window=10).mean()\n",
        "        data['Returns'] = data['Close'].pct_change()\n",
        "\n",
        "        # 3. تحديد الهدف (Target): هل سيرتفع السعر غداً؟ (1 = نعم، 0 = لا)\n",
        "        data['Target'] = (data['Close'].shift(-1) > data['Close']).astype(int)\n",
        "\n",
        "        # 4. تنظيف البيانات\n",
        "        data = data.dropna()\n",
        "\n",
        "        # 5. تقسيم البيانات وتدريب النموذج\n",
        "        X = data[['Close', 'MA5', 'MA10', 'Returns']]\n",
        "        y = data['Target']\n",
        "\n",
        "        model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
        "        model.fit(X, y) # تدريب النموذج\n",
        "\n",
        "        # 6. التنبؤ لليوم التالي (نأخذ آخر صف متاح في البيانات)\n",
        "        last_row = X.iloc[-1:]\n",
        "        prediction = model.predict(last_row)[0]\n",
        "        confidence = model.predict_proba(last_row)[0][prediction] * 100\n",
        "\n",
        "        if prediction == 1:\n",
        "            result_text = f\"📈 التوقع: السعر سيرتفع غداً (نسبة الثقة: {confidence:.1f}%)\"\n",
        "        else:\n",
        "            result_text = f\"📉 التوقع: السعر سينخفض غداً (نسبة الثقة: {confidence:.1f}%)\"\n",
        "\n",
        "        # 7. رسم الرسم البياني (آخر 3 أشهر للوضوح)\n",
        "        fig, ax = plt.subplots(figsize=(8, 4))\n",
        "        ax.plot(data.index[-90:], data['Close'][-90:], color='blue', label='Price')\n",
        "        ax.set_title(f\"سعر الإغلاق لـ {ticker_symbol} (آخر 3 أشهر)\")\n",
        "        ax.grid(True)\n",
        "        ax.legend()\n",
        "\n",
        "        return result_text, fig\n",
        "\n",
        "    except Exception as e:\n",
        "        return f\"حدث خطأ: {e}\", None\n",
        "\n",
        "# بناء واجهة التطبيق الجديدة\n",
